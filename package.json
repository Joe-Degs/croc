{
	"name": "croc",
	"version": "0.2.2",
	"description": "Taskplane launcher and profile manager for Pi",
	"type": "module",
	"bin": {
		"croc": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"CHANGELOG.md",
		"dist",
		"docs/config.md",
		"docs/release.md",
		"examples",
		"skills",
		"schemas",
		"README.md"
	],
	"workspaces": [
		"packages/taskplane"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"check": "biome check --write --error-on-warnings src tests && tsgo --noEmit",
		"dev": "tsx src/cli.ts",
		"pack:check": "node scripts/validate-package.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:assets": "node scripts/build-release-assets.mjs",
		"prepublishOnly": "npm run build",
		"test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
	},
	"dependencies": {
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"headroom-ai": "^0.22.4",
		"taskplane": "file:packages/taskplane",
		"yaml": "^2.9.0"
	},
	"bundledDependencies": [
		"taskplane"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.78.1",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Joe-Degs/croc.git"
	},
	"keywords": [
		"pi",
		"taskplane",
		"coding-agent",
		"launcher"
	],
	"license": "MIT"
}
