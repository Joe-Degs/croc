{
	"name": "croc",
	"version": "0.1.0",
	"description": "Taskplane launcher and profile manager for Pi",
	"type": "module",
	"bin": {
		"croc": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"skills",
		"schemas",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit",
		"dev": "tsx src/cli.ts"
	},
	"dependencies": {
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"taskplane": "0.30.1",
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.78.1",
		"@types/cross-spawn": "6.0.6",
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi",
		"taskplane",
		"coding-agent",
		"launcher"
	],
	"license": "MIT"
}
